# Configuration du projet AFEMC-CI - copier en .env et renseigner
DJANGO_SECRET_KEY=remplacer-par-une-cle-secrete-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
POSTGRES_DB=afemc_ci
POSTGRES_USER=afemc
POSTGRES_PASSWORD=motdepasse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Mettre a 1 pour utiliser SQLite (essai rapide sans PostgreSQL)
USE_SQLITE=0

# Base des liens absolus dans les courriels (activation de compte, etc.)
SITE_URL=http://127.0.0.1:8000

# Courtier Celery (acheminement automatique des notifications et détection
# des retards, § 5.6.1). Redis doit être démarré pour que ces tâches tournent.
CELERY_BROKER_URL=redis://localhost:6379/0

# Service d'envoi de courriels : API HTTP de Brevo (https://www.brevo.com),
# gratuit jusqu'à 300 courriels/jour — voir README § 3 « Service de
# messagerie ». Clé à générer dans Brevo > Paramètres > Clés API. Envoi en
# HTTPS plutôt qu'en SMTP : plus fiable sur les hébergeurs qui limitent les
# ports sortants non standards (voir README § 7, incident Render).
BREVO_API_KEY=
EMAIL_EXPEDITEUR=gestion@afemc-ci.org

# Paramètres fonctionnels par défaut
COTISATION_MONTANT_DEFAUT=25000
